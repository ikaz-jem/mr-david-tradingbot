BINANCE_TESTNET=true
OPENAI_API_KEY=
OPENAI_MODEL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_SUPPORT_EMAIL=
RESEND_WEBHOOK_SECRET=
PAYSTACK_SANDBOX_ENABLED=false
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_CURRENCY=
PAYSTACK_WEBHOOK_CONFIRMED=false
PAYSTACK_MERCHANT_APPROVED=false
PAYSTACK_ALLOWED_COUNTRIES=
BILLING_LIVE_ENABLED=false
