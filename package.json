{
  "name": "enrivea-trade-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:atlas": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-dev-atlas.ps1",
    "build": "next build",
    "start": "next start",
    "make-admin": "node --env-file=.env.local scripts/promote-admin.mjs",
    "create-admin": "node --env-file=.env.local scripts/create-admin.mjs",
    "seed:live": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-atlas-direct.ps1 scripts/seed-live.mjs",
    "seed:affiliate-showcase": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-atlas-direct.ps1 scripts/seed-live-affiliate-showcase.mjs",
    "seed:affiliate-showcase-available": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-atlas-direct.ps1 scripts/seed-live-affiliate-showcase.mjs --available",
    "migrate:activation": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-atlas-direct.ps1 scripts/migrate-activation-model.mjs",
    "migrate:access": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-atlas-direct.ps1 scripts/migrate-access-control.mjs",
    "migrate:approval-execution": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-atlas-direct.ps1 scripts/migrate-approval-execution.mjs",
    "migrate:exchange-markets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-atlas-direct.ps1 scripts/migrate-exchange-market-connections.mjs",
    "typecheck": "tsc --noEmit",
    "check:production": "node --env-file=.env.local scripts/check-production-readiness.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mjs",
    "smoke:approval": "node scripts/smoke-approval-desk.mjs",
    "smoke:operations": "node scripts/smoke-operations-controls.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/urbanist": "^5.3.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.468.0",
    "mongoose": "9.10.2",
    "next": "16.3.6",
    "next-auth": "4.24.15",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.2.0",
    "resend": "^6.29.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  }
}
